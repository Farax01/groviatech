# Copy to .env.local and set values from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the anon / publishable key. Never put a service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Resend notifications for new contact-form leads. Keep this key server-side.
RESEND_API_KEY=re_your_api_key
LEAD_NOTIFICATION_EMAIL=groviatechh@gmail.com
# Use onboarding@resend.dev for testing to your Resend account email, or a verified domain sender.
LEADS_FROM_EMAIL=onboarding@resend.dev
